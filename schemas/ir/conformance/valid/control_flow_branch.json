{
  "ir_format": "v2.4.0",
  "tau_version": "0.0.0",
  "target": "linux-native-strict",
  "workflow": {
    "agents": {
      "inner-agent": {
        "id": "inner-agent",
        "prompt": "You are a helpful agent invoked in the then-branch.",
        "model_ref": {
          "backend": "anthropic",
          "model_id": "claude-haiku-4-5"
        },
        "tool_refs": [],
        "context": null,
        "budget": {
          "max_turns": 5,
          "max_tokens": null
        }
      }
    },
    "tools": {},
    "steps": {},
    "edges": [],
    "capability_table": {},
    "pipeline": {
      "steps": [
        {
          "id": "branch-step",
          "input": "${input}",
          "run": {
            "Branch": {
              "on": {
                "evaluates": {
                  "Path": "/flag"
                },
                "predicate": "Exists"
              },
              "then": [
                {
                  "id": "inner",
                  "input": "${input}",
                  "run": {
                    "Agent": "inner-agent"
                  }
                }
              ],
              "otherwise": []
            }
          }
        }
      ]
    }
  }
}

{
  "ir_format": "v2.2.0",
  "tau_version": "0.0.0",
  "target": "x86_64-unknown-linux-native-strict",
  "workflow": {
    "agents": {
      "summarizer": {
        "id": "summarizer",
        "prompt": "Summarize the daily data.",
        "model_ref": {
          "backend": "anthropic",
          "model_id": "claude-haiku-4-5"
        },
        "tool_refs": [],
        "context": null,
        "budget": {
          "max_turns": 5,
          "max_tokens": null
        }
      }
    },
    "tools": {},
    "steps": {},
    "edges": [],
    "capability_table": {}
  },
  "triggers": [
    {
      "name": "nightly",
      "kind": "cron",
      "agent": "summarizer",
      "schedule": "0 3 * * *",
      "timezone": "UTC",
      "retry": {
        "max_attempts": 3,
        "backoff": {
          "strategy": "exponential",
          "base": "30s",
          "max": "10m"
        },
        "dead_letter": null
      }
    },
    {
      "name": "on-demand",
      "kind": "manual",
      "agent": "summarizer",
      "schedule": null,
      "timezone": null,
      "retry": {
        "max_attempts": 1,
        "backoff": {
          "strategy": "fixed",
          "base": "5s",
          "max": "5s"
        },
        "dead_letter": "mcp:dlq-sink"
      }
    }
  ]
}

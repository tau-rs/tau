# cargo-fuzz build artifacts and crash corpus. The `corpus/` directory is
# committed (seed inputs) but `corpus/<target>/crashes` and `artifacts/`
# are runtime output that should not be checked in.
target/
artifacts/
coverage/

# Generated on first standalone build (each fuzz project is its own workspace
# root). Matches how the repo treats other out-of-workspace lockfiles.
Cargo.lock
